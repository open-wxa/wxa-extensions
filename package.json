{
  "name": "@open-wxa/wxa-inspector-monorepo",
  "private": true,
  "description": "在 wxa-runner 里点选小程序页面上的元素，直接在编辑器打开对应源码",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run tests/unit",
    "test:e2e": "pnpm build && vitest run tests/e2e",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@open-wxa/wxa-inspector": "workspace:*",
    "@types/node": "^20.10.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
