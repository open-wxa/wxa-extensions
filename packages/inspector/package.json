{
  "name": "@open-wxa/wxa-inspector",
  "version": "0.0.0",
  "description": "Element inspector for wxa-runner: hover to highlight, click to open the source in your editor",
  "keywords": [
    "inspector",
    "miniprogram",
    "weapp",
    "wechat",
    "wxa-runner"
  ],
  "homepage": "https://github.com/open-wxa/wxa-extensions/tree/main/packages/inspector#readme",
  "bugs": {
    "url": "https://github.com/open-wxa/wxa-extensions/issues"
  },
  "license": "MIT",
  "author": "open-wxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-extensions.git",
    "directory": "packages/inspector"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "launch-editor": "^2.10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
