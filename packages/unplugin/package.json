{
  "name": "@open-wxa/unplugin-wxa-runner",
  "version": "0.1.0",
  "description": "Vite / webpack plugin that runs uni-app and Taro mp-weixin builds in wxa-runner, with optional runner extensions",
  "keywords": [
    "miniprogram",
    "taro",
    "uni-app",
    "unplugin",
    "vite-plugin",
    "webpack-plugin",
    "wxa-runner"
  ],
  "homepage": "https://github.com/open-wxa/wxa-extensions/tree/main/packages/unplugin#readme",
  "bugs": {
    "url": "https://github.com/open-wxa/wxa-extensions/issues"
  },
  "license": "MIT",
  "author": "open-wxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-extensions.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "unplugin": "^3.5.0"
  },
  "devDependencies": {
    "@open-wxa/wxa-runner-core": "^0.8.2"
  },
  "peerDependencies": {
    "@open-wxa/wxa-runner-core": ">=0.8.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
